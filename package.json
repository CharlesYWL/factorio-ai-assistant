{
  "name": "factorio-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Factorio 2.0 in-game advisor and loopback companion",
  "type": "module",
  "workspaces": [
    "packages/*",
    "companion"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "npm run start --workspace @factorio-ai-assistant/companion",
    "calculate": "node packages/calculator/dist/cli.js",
    "pretest": "npm run build",
    "test": "node --test packages/*/dist/*.test.js companion/dist/*.test.js",
    "lint": "eslint . && node scripts/lint-factorio-mod.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "luaparse": "^0.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
