diff --git a/spec/remote_interface_spec.lua b/spec/remote_interface_spec.lua
new file mode 100644
index 0000000000000000000000000000000000000000..3c5e4344388f5b94e61fd284cdd9eb6277c3696f
--- /dev/null
+++ b/spec/remote_interface_spec.lua
@@ -0,0 +1,304 @@
+--[[
+  Tests for the todo_list remote interface.
+
+  The spec is self contained: it stubs the small part of the Factorio API that
+  the interface touches instead of booting a world, so it runs with plain
+  busted from the repository root.
+]]--
+describe("remote interface", function()
+
+  local registered
+  local refreshed
+
+  local save_task_to_open_list
+
+  setup(function()
+    _G.todo = {}
+    dofile("src/todo/features/add_task.lua")
+    dofile("src/todo/features/remote_interface.lua")
+
+    save_task_to_open_list = todo.save_task_to_open_list
+    todo.log = function() end
+
+    -- Verbatim from upstream src/todo/helper.lua.
+    todo.get_task_by_id = function(id)
+      for _, task in pairs(_G.storage.todo.open) do
+        if (task.id == id) then
+          return task
+        end
+      end
+
+      for _, task in pairs(_G.storage.todo.done) do
+        if (task.id == id) then
+          return task
+        end
+      end
+    end
+  end)
+
+  before_each(function()
+    refreshed = 0
+    registered = nil
+
+    todo.save_task_to_open_list = save_task_to_open_list
+    todo.update_export_dialog_button_state = function() end
+    todo.update_main_task_list_for_everyone = function()
+      refreshed = refreshed + 1
+    end
+
+    local players = {}
+    for index, name in ipairs({ "Charles", "Jonas" }) do
+      players[index] = { index = index, name = name, valid = true }
+    end
+
+    _G.storage = { todo = { open = {}, done = {}, settings = {} } }
+    _G.serpent = {
+      block = function()
+        return ""
+      end,
+      dump = function()
+        return ""
+      end,
+    }
+    _G.game = {
+      players = players,
+      -- Mirrors the API: get_player raises instead of returning nil when the
+      -- index is not a uint.
+      get_player = function(index)
+        if type(index) ~= "number" or index ~= index or index % 1 ~= 0
+          or index < 0 or index > 4294967295 then
+          error("Value must be a valid uint")
+        end
+        return players[index]
+      end,
+    }
+    _G.remote = {
+      add_interface = function(name, functions)
+        registered = { name = name, functions = functions }
+      end,
+    }
+  end)
+
+  local function add(payload)
+    return todo.remote_add_task(payload)
+  end
+
+  local function valid_payload(overrides)
+    local payload = {
+      player_index = 1,
+      title = "Build 4 more assemblers",
+      description = "Iron gears are the bottleneck.",
+    }
+    for key, value in pairs(overrides or {}) do
+      payload[key] = value
+    end
+    return payload
+  end
+
+  it("registers exactly the documented calls", function()
+    todo.register_remote_interface()
+
+    assert.is_equal("todo_list", registered.name)
+    assert.is_function(registered.functions.api_version)
+    assert.is_function(registered.functions.add_task)
+
+    local count = 0
+    for _ in pairs(registered.functions) do
+      count = count + 1
+    end
+    assert.is_equal(2, count)
+  end)
+
+  it("reports the api version", function()
+    assert.is_equal(1, todo.remote_api_version())
+  end)
+
+  it("creates a task through the regular code path", function()
+    local result = add(valid_payload({ assignee = "Jonas" }))
+
+    assert.is_true(result.created)
+    assert.is_equal(1, result.id)
+    assert.is_equal(1, #_G.storage.todo.open)
+
+    local task = _G.storage.todo.open[1]
+    assert.is_equal(1, task.id)
+    assert.is_equal("Build 4 more assemblers", task.title)
+    assert.is_equal("Iron gears are the bottleneck.", task.task)
+    assert.is_equal("Jonas", task.assignee)
+    assert.is_equal("Charles", task.created_by)
+    assert.is_equal("Charles", task.updated_by)
+    assert.is_equal(1, refreshed)
+  end)
+
+  it("appends by default and prepends on request", function()
+    add(valid_payload({ title = "first" }))
+    add(valid_payload({ title = "second" }))
+    add(valid_payload({ title = "third", add_to_top = true }))
+
+    assert.is_equal("third", _G.storage.todo.open[1].title)
+    assert.is_equal("first", _G.storage.todo.open[2].title)
+    assert.is_equal("second", _G.storage.todo.open[3].title)
+  end)
+
+  it("accepts task as an alias for description", function()
+    local result = add({ player_index = 1, title = "title", task = "body" })
+
+    assert.is_true(result.created)
+    assert.is_equal("body", _G.storage.todo.open[1].task)
+  end)
+
+  it("defaults the description to an empty string", function()
+    local result = add({ player_index = 1, title = "title" })
+
+    assert.is_true(result.created)
+    assert.is_equal("", _G.storage.todo.open[1].task)
+  end)
+
+  it("strips control characters and trims whitespace", function()
+    add({
+      player_index = 1,
+      title = "  clean\1 title  ",
+      description = "line one\nline two\0",
+    })
+
+    assert.is_equal("clean title", _G.storage.todo.open[1].title)
+    assert.is_equal("line one\nline two", _G.storage.todo.open[1].task)
+  end)
+
+  local rejections = {
+    { name = "a payload that is not a table", payload = "nope", code = "invalid_payload" },
+    { name = "a missing player index", payload = { title = "t" }, code = "invalid_player_index" },
+    {
+      name = "a player index of the wrong type",
+      payload = { player_index = "1", title = "t" },
+      code = "invalid_player_index",
+    },
+    {
+      name = "an unknown player",
+      payload = { player_index = 99, title = "t" },
+      code = "unknown_player",
+    },
+    {
+      name = "a fractional player index",
+      payload = { player_index = 1.5, title = "t" },
+      code = "invalid_player_index",
+    },
+    {
+      name = "a negative player index",
+      payload = { player_index = -1, title = "t" },
+      code = "invalid_player_index",
+    },
+    {
+      name = "a player index of zero",
+      payload = { player_index = 0, title = "t" },
+      code = "invalid_player_index",
+    },
+    {
+      name = "an infinite player index",
+      payload = { player_index = math.huge, title = "t" },
+      code = "invalid_player_index",
+    },
+    {
+      name = "a player index that is not a number at all",
+      payload = { player_index = 0 / 0, title = "t" },
+      code = "invalid_player_index",
+    },
+    { name = "a missing title", payload = { player_index = 1 }, code = "invalid_title" },
+    {
+      name = "a blank title",
+      payload = { player_index = 1, title = "   " },
+      code = "invalid_title",
+    },
+    {
+      name = "a title of the wrong type",
+      payload = { player_index = 1, title = 42 },
+      code = "invalid_title",
+    },
+    {
+      name = "an oversized title",
+      payload = { player_index = 1, title = string.rep("a", 201) },
+      code = "title_too_long",
+    },
+    {
+      name = "a description of the wrong type",
+      payload = { player_index = 1, title = "t", description = {} },
+      code = "invalid_description",
+    },
+    {
+      name = "an oversized description",
+      payload = { player_index = 1, title = "t", description = string.rep("a", 4001) },
+      code = "description_too_long",
+    },
+    {
+      name = "an assignee of the wrong type",
+      payload = { player_index = 1, title = "t", assignee = 7 },
+      code = "invalid_assignee",
+    },
+    {
+      name = "an unknown assignee",
+      payload = { player_index = 1, title = "t", assignee = "Nobody" },
+      code = "unknown_assignee",
+    },
+    {
+      name = "an add_to_top that is not a boolean",
+      payload = { player_index = 1, title = "t", add_to_top = "yes" },
+      code = "invalid_add_to_top",
+    },
+  }
+
+  for _, rejection in ipairs(rejections) do
+    it("rejects " .. rejection.name, function()
+      local result = add(rejection.payload)
+
+      assert.is_false(result.created)
+      assert.is_equal(rejection.code, result.error)
+      assert.is_string(result.message)
+      assert.is_equal(0, #_G.storage.todo.open)
+      assert.is_equal(0, refreshed)
+    end)
+  end
+
+  it("rejects calls before the mod is initialized", function()
+    _G.storage = {}
+
+    local result = add(valid_payload())
+
+    assert.is_false(result.created)
+    assert.is_equal("not_initialized", result.error)
+  end)
+
+  it("still reports success when a gui side effect of saving fails", function()
+    todo.update_export_dialog_button_state = function()
+      error("main frame is half built")
+    end
+
+    local result = add(valid_payload())
+
+    assert.is_true(result.created)
+    assert.is_equal(1, result.id)
+    assert.is_equal(1, #_G.storage.todo.open)
+  end)
+
+  it("still reports success when the list refresh fails", function()
+    todo.update_main_task_list_for_everyone = function()
+      error("gui exploded")
+    end
+
+    local result = add(valid_payload())
+
+    assert.is_true(result.created)
+    assert.is_equal(1, #_G.storage.todo.open)
+  end)
+
+  it("reports an internal error instead of raising when saving fails outright", function()
+    todo.save_task_to_open_list = function()
+      error("disk on fire")
+    end
+
+    local result = add(valid_payload())
+
+    assert.is_false(result.created)
+    assert.is_equal("internal_error", result.error)
+    assert.is_equal(0, #_G.storage.todo.open)
+  end)
+end)
