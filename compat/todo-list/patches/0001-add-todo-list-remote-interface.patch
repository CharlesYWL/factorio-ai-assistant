diff --git a/src/todo/features/remote_interface.lua b/src/todo/features/remote_interface.lua
new file mode 100644
index 0000000000000000000000000000000000000000..bbbd375a03ac5a6f1f0eaf1bc64ffac35df76401
--- /dev/null
+++ b/src/todo/features/remote_interface.lua
@@ -0,0 +1,217 @@
+--[[
+  A small, generic remote interface.
+
+  It lets other mods add a task to the shared todo list without reaching into
+  `storage.todo` or the GUI. Everything goes through the same code path the
+  add dialog uses, so a remotely created task is indistinguishable from a task
+  a player typed in.
+
+  The interface is registered from control.lua, which is the only place where
+  `remote.add_interface` may be called.
+]]--
+
+todo.remote_interface_name = "todo_list"
+
+-- Bump on every breaking change to the remote contract. Additive changes keep
+-- the version stable, so callers can guard with `api_version() >= n`.
+local API_VERSION = 1
+
+local MAX_TITLE_LENGTH = 200
+local MAX_DESCRIPTION_LENGTH = 4000
+local MAX_PLAYER_INDEX = 4294967295
+
+local function failure(code, message)
+    return { created = false, error = code, message = message }
+end
+
+--[[
+  Drops control characters a caller should never be able to inject into the
+  GUI and trims surrounding whitespace. Tabs, newlines and carriage returns
+  survive in the description because the details view renders multi line text.
+]]--
+local function sanitize(text, keep_newlines)
+    local forbidden = keep_newlines and "[\0-\8\11\12\14-\31\127]" or "[\0-\31\127]"
+    local cleaned = string.gsub(text, forbidden, "")
+    return (string.match(cleaned, "^%s*(.-)%s*$"))
+end
+
+local function read_string(payload, keys, options)
+    local value
+    for _, key in ipairs(keys) do
+        if payload[key] ~= nil then
+            value = payload[key]
+            break
+        end
+    end
+
+    if value == nil then
+        if options.required then
+            return nil, failure(options.missing_error, options.label .. " is required")
+        end
+        return nil, nil
+    end
+
+    if type(value) ~= "string" then
+        return nil, failure(options.type_error, options.label .. " must be a string")
+    end
+
+    local cleaned = sanitize(value, options.keep_newlines)
+
+    if cleaned == "" then
+        if options.required then
+            return nil, failure(options.missing_error, options.label .. " must not be empty")
+        end
+        return nil, nil
+    end
+
+    -- Factorio ships Lua without the utf8 library, so the budget is in bytes.
+    if string.len(cleaned) > options.max_length then
+        return nil, failure(
+            options.length_error,
+            options.label .. " must be at most " .. options.max_length .. " bytes"
+        )
+    end
+
+    return cleaned, nil
+end
+
+--[[
+  `game.get_player` expects a uint and raises on anything else, so the index is
+  fully validated before it reaches the API. Raising inside a remote call would
+  take the calling mod down with it.
+]]--
+local function read_player(payload)
+    local index = payload.player_index
+    if type(index) ~= "number"
+        or index ~= index
+        or index % 1 ~= 0
+        or index < 1
+        or index > MAX_PLAYER_INDEX then
+        return nil, failure("invalid_player_index", "player_index must be a positive integer")
+    end
+
+    local player = game.get_player(index)
+    if not player or not player.valid then
+        return nil, failure("unknown_player", "player_index does not belong to a valid player")
+    end
+
+    return player, nil
+end
+
+local function read_assignee(payload)
+    local assignee, rejection = read_string(payload, { "assignee" }, {
+        label = "assignee",
+        max_length = MAX_TITLE_LENGTH,
+        type_error = "invalid_assignee",
+        length_error = "invalid_assignee",
+        keep_newlines = false,
+    })
+    if rejection then
+        return nil, rejection
+    end
+    if assignee == nil then
+        return nil, nil
+    end
+
+    for _, player in pairs(game.players) do
+        if player.name == assignee then
+            return assignee, nil
+        end
+    end
+
+    return nil, failure("unknown_assignee", "assignee is not a known player name")
+end
+
+--[[
+  Adds one task to the open list.
+
+  payload:
+    player_index  (number, required)  the player the task is created by
+    title         (string, required)  short task title
+    description   (string, optional)  long text, `task` is accepted as an alias
+    assignee      (string, optional)  name of an existing player
+    add_to_top    (boolean, optional) prepend instead of append
+
+  @return { created = true, id = <number> } on success
+  @return { created = false, error = <string>, message = <string> } otherwise
+]]--
+function todo.remote_add_task(payload)
+    if type(payload) ~= "table" then
+        return failure("invalid_payload", "payload must be a table")
+    end
+
+    if not storage.todo or not storage.todo.open then
+        return failure("not_initialized", "the todo list is not initialized yet")
+    end
+
+    local player, player_rejection = read_player(payload)
+    if player_rejection then
+        return player_rejection
+    end
+
+    local title, title_rejection = read_string(payload, { "title" }, {
+        label = "title",
+        required = true,
+        max_length = MAX_TITLE_LENGTH,
+        missing_error = "invalid_title",
+        type_error = "invalid_title",
+        length_error = "title_too_long",
+        keep_newlines = false,
+    })
+    if title_rejection then
+        return title_rejection
+    end
+
+    local description, description_rejection = read_string(payload, { "description", "task" }, {
+        label = "description",
+        max_length = MAX_DESCRIPTION_LENGTH,
+        type_error = "invalid_description",
+        length_error = "description_too_long",
+        keep_newlines = true,
+    })
+    if description_rejection then
+        return description_rejection
+    end
+
+    local assignee, assignee_rejection = read_assignee(payload)
+    if assignee_rejection then
+        return assignee_rejection
+    end
+
+    if payload.add_to_top ~= nil and type(payload.add_to_top) ~= "boolean" then
+        return failure("invalid_add_to_top", "add_to_top must be a boolean")
+    end
+
+    local assembled, task = pcall(todo.assemble_task, {
+        ["title"] = title,
+        ["task"] = description or "",
+        ["assignee"] = assignee,
+    }, player)
+
+    if not assembled then
+        return failure("internal_error", tostring(task))
+    end
+
+    -- `save_task_to_open_list` inserts the task and only then refreshes the
+    -- export button, so a GUI problem must not be reported as a failed
+    -- creation once the task is already in the list.
+    local saved, save_error = pcall(todo.save_task_to_open_list, task, payload.add_to_top == true)
+    if not saved and todo.get_task_by_id(task.id) == nil then
+        return failure("internal_error", tostring(save_error))
+    end
+
+    pcall(todo.update_main_task_list_for_everyone)
+
+    return { created = true, id = task.id }
+end
+
+function todo.remote_api_version()
+    return API_VERSION
+end
+
+function todo.register_remote_interface()
+    remote.add_interface(todo.remote_interface_name, {
+        api_version = todo.remote_api_version,
+        add_task = todo.remote_add_task,
+    })
